{
  "name": "Claude",
  "slug": "code-review",
  "title": "Principal Code Reviewer",
  "role": "reviewer",
  "icon": "shield-check",
  "capabilities": "Deep static analysis, spec-compliance verification, security review, architectural critique, integration-hazard detection, asyncio lifecycle analysis",
  "reportsTo": "ceo",
  "adapter": {
    "type": "hermes_local",
    "config": {
      "model": "tencent/hy3-preview",
      "provider": "openrouter",
      "persistSession": true,
      "timeoutSec": 300
    }
  },
  "runtime": {
    "heartbeatIntervalSec": 0,
    "timeoutSec": 1500,
    "interruptGraceSec": 30
  },
  "permissions": {
    "filesystem": {
      "read": ["**"],
      "write": [],
      "denyWrite": ["**"]
    },
    "shell": {
      "allow": [
        "rtk git diff *",
        "rtk git log *",
        "rtk git show *",
        "rtk git status",
        "rtk git branch",
        "rtk grep *",
        "rtk proxy pytest *",
        "rtk pytest *",
        "rtk node --check *",
        "ls *",
        "cat *",
        "head *",
        "tail *"
      ],
      "deny": [
        "rm *",
        "git push*",
        "git commit*",
        "git add*",
        "git merge*",
        "git checkout*",
        "ssh *",
        "curl *",
        "sudo *"
      ]
    }
  },
  "budgetMonthlyCents": 0,
  "envInputs": [
    {
      "key": "ANTHROPIC_API_KEY",
      "scope": "agent",
      "required": true
    }
  ]
}
