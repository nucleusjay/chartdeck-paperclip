{
  "schema_version": 1,
  "id": "code-review",
  "name": "Claude",
  "title": "Principal Code Reviewer",
  "type": "Claude Agent (local)",
  "role": "Code Review",
  "capabilities": [
    "Deep static analysis",
    "Spec-compliance verification",
    "Security review",
    "Architectural critique",
    "Integration-hazard detection"
  ],
  "instructions_file": "instructions.md",
  "command": "claude",
  "model": "claude-sonnet-4-7",
  "thinking_effort": "high",
  "extra_args": [
    "--system-prompt-file=instructions.md",
    "--dangerously-skip-permissions=true"
  ],
  "env": [
    "ANTHROPIC_API_KEY",
    "CHARTDECK_LOCAL_PATH",
    "CHARTDECK_BRANCH_DEFAULT",
    "RTK_ENABLED"
  ],
  "timeout_sec": 1500,
  "interrupt_grace_sec": 30,
  "run_policy": {
    "heartbeat_interval_sec": 0,
    "resume_on": ["dispatch_from_ceo"]
  },
  "permissions": {
    "filesystem": {
      "read": ["**"],
      "write": [],
      "deny_write": ["**"]
    },
    "shell": {
      "allow": [
        "rtk git diff *",
        "rtk git log *",
        "rtk git show *",
        "rtk git status",
        "rtk git branch",
        "rtk grep *",
        "rtk proxy pytest *",
        "rtk pytest *",
        "rtk node --check *",
        "ls *",
        "cat *",
        "head *",
        "tail *"
      ],
      "deny": [
        "rm *",
        "git push*",
        "git commit*",
        "git add*",
        "git merge*",
        "git checkout*",
        "ssh *",
        "curl *",
        "sudo *"
      ]
    },
    "network": {
      "allow": [
        "https://api.anthropic.com/**"
      ]
    },
    "dispatch_to": []
  }
}
