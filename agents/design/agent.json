{
  "schema_version": 1,
  "id": "design",
  "name": "Google",
  "title": "Design Lead",
  "type": "Gemini Agent (local)",
  "role": "Design",
  "capabilities": [
    "UI/UX visual reasoning",
    "Mockup generation",
    "Screenshot analysis",
    "Design-system definition",
    "Multimodal review"
  ],
  "instructions_file": "instructions.md",
  "command": "gemini",
  "model": "gemini-2.5-pro",
  "thinking_effort": "high",
  "extra_args": [
    "--mode=multimodal",
    "--max-tokens=8192"
  ],
  "env": [
    "GEMINI_API_KEY",
    "CHARTDECK_REPO",
    "CHARTDECK_LOCAL_PATH",
    "CHARTDECK_PORT",
    "BROWSE_SCREENSHOT_DIR"
  ],
  "timeout_sec": 1200,
  "interrupt_grace_sec": 10,
  "run_policy": {
    "heartbeat_interval_sec": 0,
    "resume_on": ["dispatch_from_ceo"]
  },
  "permissions": {
    "filesystem": {
      "read": ["**"],
      "write": [
        "docs/superpowers/specs/**",
        "docs/superpowers/notes/**",
        "design-artifacts/**"
      ],
      "deny_write": [
        "chartdeck/**",
        "static/**",
        "tests/**",
        "app.py",
        ".env",
        ".env.*",
        "/secrets/**"
      ]
    },
    "shell": {
      "allow": [
        "rtk *",
        "git status",
        "git log",
        "git diff",
        "git show",
        "ls *",
        "cat *",
        "convert *",
        "ffmpeg *"
      ],
      "deny": [
        "rm -rf *",
        "git push*",
        "git commit*",
        "sudo *"
      ]
    },
    "network": {
      "allow": [
        "https://generativelanguage.googleapis.com/**",
        "https://aistudio.google.com/**"
      ]
    },
    "dispatch_to": []
  }
}
