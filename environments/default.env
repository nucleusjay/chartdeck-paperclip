# Shared environment template for chartdeck-dev
# Secrets are left blank intentionally; configure these securely in the Paperclip UI.

# Anthropic API Key for Hermes (CEO) and Claude (reviewer)
ANTHROPIC_API_KEY=

# OpenAI API Key for Codex (coding)
OPENAI_API_KEY=

# Gemini/Google API Key for Google (design)
GEMINI_API_KEY=

# GitHub Token for repository pushes and PR management (Hermes)
GITHUB_TOKEN=

# Telegram Bot Token for owner messaging bridge
TELEGRAM_BOT_TOKEN=

# Telegram Allowed Users (comma-separated list of Telegram User IDs)
TELEGRAM_ALLOWED_USERS=

# Path to deploy SSH private key inside agent container
SSH_PRIVATE_KEY_PATH=
